Bootstrap: library
From: ubuntu:18.04
Stage: build

%environment
    PYTHONUNBUFFERED=1

%files
    ./requirements.txt /requirements.txt

%post
    apt-get update
    apt-get install -y python3 python3-pip python3-setuptools
    pip3 install -r requirements.txt

%labels
    Author YOUR_NAME
    Version v0.0.1

%help
    This is a demo container used to illustrate a def file that uses all
    supported sections.
